//- filepath: /home/dsala/TWM-2026/views/index.pug
extends layout

block content
  //- Hero Section
  .row.align-items-center.py-5
    .col-lg-6
      h1.display-4.fw-bold.text-primary
        i.bi.bi-stack
        |  TWM-2026
      p.lead.text-muted= description
      .d-flex.gap-3.mt-4
        a.btn.btn-primary.btn-lg(href='/users')
          i.bi.bi-people-fill.me-2
          | Ver Usuarios
        a.btn.btn-outline-secondary.btn-lg(href='/api/health')
          i.bi.bi-activity.me-2
          | API Health
    .col-lg-6.text-center
      i.bi.bi-layers-fill(style='font-size: 10rem; color: var(--bs-primary);')

  hr

  //- Tecnologías
  .row.mt-5
    .col-12.text-center.mb-4
      h2.fw-bold Stack Tecnológico
    .col-md-3.col-sm-6.mb-4
      .card.h-100.text-center.shadow-sm.border-success
        .card-body
          i.bi.bi-database-fill.display-4.text-success
          h5.card-title.mt-3 MongoDB
          p.card-text.text-muted Base de datos NoSQL orientada a documentos
    .col-md-3.col-sm-6.mb-4
      .card.h-100.text-center.shadow-sm.border-warning
        .card-body
          i.bi.bi-server.display-4.text-warning
          h5.card-title.mt-3 Express
          p.card-text.text-muted Framework web minimalista para Node.js
    .col-md-3.col-sm-6.mb-4
      .card.h-100.text-center.shadow-sm.border-danger
        .card-body
          i.bi.bi-triangle-fill.display-4.text-danger
          h5.card-title.mt-3 Angular
          p.card-text.text-muted Framework SPA para el frontend
    .col-md-3.col-sm-6.mb-4
      .card.h-100.text-center.shadow-sm.border-primary
        .card-body
          i.bi.bi-node-plus-fill.display-4.text-primary
          h5.card-title.mt-3 Node.js
          p.card-text.text-muted Entorno de ejecución JavaScript del lado del servidor